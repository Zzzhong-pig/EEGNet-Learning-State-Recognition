EEG_MIXED_ENSEMBLE_MANIFEST=artifacts/production/manifest.json
EEG_REQUIRE_MODEL=true
EEG_VERIFY_ARTIFACTS=true
EEG_JSON_LOGS=true
EEG_MAX_BATCH_SIZE=64
EEG_MAX_CONCURRENT_INFERENCES=1
# Set in the deployment secret store; omit locally to disable API-key authentication.
# EEG_API_KEY=replace-with-a-secret
